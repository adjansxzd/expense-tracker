== F2 input validation ==
$ expense-tracker add 2026-11-03 food -50
usage: expense-tracker [-h] [--file FILE] {add,list,report,export} ...
expense-tracker: error: amount must be greater than 0
[exit code: 2]
$ expense-tracker add 2026-13-45 food 10
usage: expense-tracker [-h] [--file FILE] {add,list,report,export} ...
expense-tracker: error: date must be a valid YYYY-MM-DD, got '2026-13-45'
[exit code: 2]
$ expense-tracker add 2026-11-04 food abc
usage: expense-tracker [-h] [--file FILE] {add,list,report,export} ...
expense-tracker: error: amount must be a number, got 'abc'
[exit code: 2]
$ expense-tracker add 2026-11-05  5
usage: expense-tracker [-h] [--file FILE] {add,list,report,export} ...
expense-tracker: error: category must not be empty
[exit code: 2]
$ expense-tracker list
[exit code: 0]
$ expense-tracker report --month 2026-11
TOTAL        0.00
[exit code: 0]

== F3 CSV formula injection ==
$ expense-tracker add 2026-11-06 misc 1 -d =HYPERLINK("http://example.invalid","click")
Added expense #1
[exit code: 0]
$ expense-tracker export /tmp/tmp.KBocaBMwEx/out.csv
Exported 1 expenses to /tmp/tmp.KBocaBMwEx/out.csv
[exit code: 0]
$ cat out.csv
id,date,category,amount,description
1,2026-11-06,misc,1.00,"=HYPERLINK(""http://example.invalid"",""click"")"

